# Linux build and launch of LogiCim (see CMakeLists.txt).
#
#   rake build    configure (first time only) and build
#   rake run      build, then launch the window
#   rake clean    delete the build directory

require 'rake/clean'

SOURCE_DIR = __dir__
BUILD_DIR  = File.expand_path('../../build/LogiCim', __dir__)
EXECUTABLE = File.join(BUILD_DIR, 'LogiCim')

# LogiCim finds Resources/ and WinInputLib's XML relative to this directory.
RUN_DIR    = File.join(__dir__, 'LogiCim')

CLEAN.include(BUILD_DIR)

task default: :build

desc 'Configure (first time only) and build LogiCim'
task :build do
  unless File.exist?(File.join(BUILD_DIR, 'build.ninja'))
    sh 'cmake', '-S', SOURCE_DIR, '-B', BUILD_DIR, '-G', 'Ninja', '-DCMAKE_BUILD_TYPE=Debug'
  end
  sh 'cmake', '--build', BUILD_DIR
end

desc 'Build and launch LogiCim'
task run: :build do
  Dir.chdir(RUN_DIR) do
    sh EXECUTABLE
  end
end
